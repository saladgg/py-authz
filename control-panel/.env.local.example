# ============================================================
# py-authz control panel (Next.js frontend) — local environment
# ============================================================
# `cp .env.local.example .env.local`, fill in the values, then `pnpm dev`.
# See ../docs/control_plane.md for the full walkthrough (dev stack, RBAC
# store, break-glass bootstrap) — the values below come from there.
#
# This app's own env vars only — the control-plane API backend it talks
# to has a separate set, in the repo root's .env.example (§3).
# ============================================================

# ------------------------------------------------------------
# The control-plane API this frontend calls (server-side only — the
# browser never talks to it directly; see README.md's BFF pattern)
# ------------------------------------------------------------
CONTROL_PLANE_API_URL=http://localhost:8000

# ------------------------------------------------------------
# OIDC provider (Keycloak) — must be the *same* realm/client the backend's
# own CONTROL_PLANE_OIDC_ISSUER/CONTROL_PLANE_OIDC_AUDIENCE point at
# ------------------------------------------------------------
OIDC_ISSUER=http://localhost:8081/realms/py-authz
OIDC_CLIENT_ID=py-authz-demo

# Where Keycloak redirects back to after login — must be registered as a
# valid redirect URI on the OIDC_CLIENT_ID client (the bundled dev realm
# already allows http://localhost:3001/*).
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ------------------------------------------------------------
# Session cookie encryption (this app's own — unrelated to any backend var)
# ------------------------------------------------------------
# 32+ character random secret used to encrypt the session cookie
# (AES-256-GCM) — generate one with `openssl rand -base64 32`. Rotating
# this invalidates every existing session (they fail to decrypt and are
# treated as logged out, not as a crash).
SESSION_SECRET=change-me-to-a-real-random-32-byte-secret
