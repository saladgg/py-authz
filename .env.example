# ==========================================================
# django-authz — Environment variables example
# ==========================================================
# Copy this file to .env and fill in real values before
# running `docker compose up`.
#
# ==========================================================

# ── Keycloak ──────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

KEYCLOAK_REALM=demo
KEYCLOAK_CLIENT_ID=django-authz-demo
KEYCLOAK_CLIENT_SECRET=change-me

# ── OpenFGA ───────────────────────────────────────────────
# Leave blank on first start; create a store via the playground
# (http://localhost:3000) and paste the store ID here.
OPENFGA_STORE_ID=

# ── Django ────────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
