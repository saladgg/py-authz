# ============================================================
# py-authz — local development environment
# ============================================================
# `cp .env.example .env`, fill in the placeholders, then `source .env`
# (bash) before running examples/, the CLI, or tests/live locally.
#
# Three groups below, independent of each other — most local sessions
# only need ONE:
#   1. OpenFGA + Keycloak/OIDC   — examples/, the CLI, tests/live
#   2. Live integration tests   — tests/live/ only, on top of (1)
#   3. Control-plane API        — py_authz/control_plane/; its own,
#                                  separate deployment, only FGA_API_URL
#                                  is shared with group 1
#
# The Next.js frontend (control-panel/) is a separate app with its own
# env file: control-panel/.env.local.example — not this one.
#
# See docs/getting_started.md (groups 1-2) and docs/control_plane.md
# (group 3) for the full walkthroughs these values come from.
# ============================================================

# ------------------------------------------------------------
# 1. OpenFGA + Keycloak/OIDC — examples/, the CLI, tests/live
# ------------------------------------------------------------
# Start with: docker compose up -d openfga keycloak

# OpenFGA. Host port 8082 matches docker-compose.yml (avoids the 8080
# collision with Keycloak). FGA_STORE_ID / FGA_MODEL_ID are printed by
# `python examples/seed.py` — copy them here.
export FGA_API_URL=http://localhost:8082
export FGA_STORE_ID=xxx
export FGA_MODEL_ID=xxx

# CLI only (`py-authz migrate --backend postgres|redis`) — a Postgres DSN
# or Redis URL for the tenant store that command reads from. Unused by
# everything else.
export TENANT_STORE_CONN=xxx

# Keycloak/OIDC — only needed for examples/05_keycloak_fastapi.py and
# tests/live. Matches the seeded realm in docker/keycloak/realm.json
# (user alice/alice, client py-authz-demo).
export KEYCLOAK_ISSUER=http://localhost:8081/realms/py-authz
export KEYCLOAK_AUDIENCE=py-authz-demo

# ------------------------------------------------------------
# 2. Live integration tests only — tests/live/, `make test-integration`
# ------------------------------------------------------------
# Also needs FGA_API_URL and KEYCLOAK_ISSUER/AUDIENCE from group 1 above.
# Start the rest with: docker compose up -d redis postgres
#
# Every test in tests/live/ SKIPS (never fails) when its required var
# here is unset, so leaving this whole group unset keeps plain
# `pytest`/`make test` fast and fully offline.
export REDIS_URL=redis://localhost:6380/0
export POSTGRES_DSN=postgres://py_authz:py_authz@localhost:5433/py_authz

# ------------------------------------------------------------
# 3. Control-plane API — py_authz/control_plane/, see docs/control_plane.md
# ------------------------------------------------------------
# Start the dev stack with:
#   docker compose up -d openfga keycloak redis postgres
# Needs its own dedicated OpenFGA store for the RBAC model (never
# FGA_STORE_ID above — see docs/control_plane.md §3) and shares only
# FGA_API_URL with group 1.

# -- Required --
export CONTROL_PLANE_FGA_STORE_ID=xxx  # from `docs/control_plane.md` §3 — a fresh, dedicated store, not FGA_STORE_ID
export CONTROL_PLANE_POSTGRES_DSN=postgres://py_authz:py_authz@localhost:5433/py_authz
export CONTROL_PLANE_OIDC_ISSUER=http://localhost:8081/realms/py-authz
export CONTROL_PLANE_OIDC_AUDIENCE=py-authz-demo

# -- Optional --
# export CONTROL_PLANE_FGA_API_URL=          # defaults to FGA_API_URL above; set only to point the RBAC store at a *different* OpenFGA server
# export CONTROL_PLANE_FGA_MODEL_ID=         # pins a specific RBAC authorization-model id instead of always using the latest
# export CONTROL_PLANE_MODEL_MODULE=examples.models  # only if the adopter's @ResourceModel classes aren't already imported some other way (see examples/14_control_plane_api.py)
# export CONTROL_PLANE_OIDC_JWKS_URL=        # skips OIDC discovery if the JWKS endpoint isn't the discovered one
# export CONTROL_PLANE_REDIS_URL=redis://localhost:6380/0  # cache stats/invalidate (CP-9) + shared rate limiting across instances (CP-16); omit to run without Redis
# export CONTROL_PLANE_BREAK_GLASS_SUBJECT=  # the *bare* OIDC `sub` (no "user:" prefix) of the first system#owner — see docs/control_plane.md §5. Only consumed once, while the RBAC store has zero grants.
# export CONTROL_PLANE_MAX_CACHED_TENANTS=1000
# export CONTROL_PLANE_MIGRATION_CONCURRENCY=10
# export CONTROL_PLANE_SA_RATE_LIMIT_MAX_ATTEMPTS=5
# export CONTROL_PLANE_SA_RATE_LIMIT_LOCKOUT_SECONDS=300
