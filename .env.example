# ----------------------------------------------------------
# OpenFGA
# ----------------------------------------------------------
# Host port 8082 matches docker-compose.yml (avoids the 8080
# collision with Keycloak). `FGA_STORE_ID` / `FGA_MODEL_ID`
# are printed by `python examples/seed.py` — copy them here.
export FGA_API_URL=http://localhost:8082
export FGA_STORE_ID=xxx
export FGA_MODEL_ID=xxx

# ----------------------------------------------------------
# Keycloak (only needed for examples/05_keycloak_fastapi.py)
# ----------------------------------------------------------
# Matches the seeded realm in docker/keycloak/realm.json.
export KEYCLOAK_ISSUER=http://localhost:8081/realms/py-authz
export KEYCLOAK_AUDIENCE=py-authz-demo
